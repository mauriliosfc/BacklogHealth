# Credenciais para testes funcionais de onboarding (Playwright)
# Copie este arquivo para .env.test e preencha com valores reais.
# .env.test está no .gitignore e nunca deve ser commitado.

# Azure DevOps — obrigatório para testes funcionais
TEST_AZ_ORG=minha-empresa
TEST_AZ_PAT=meu-pat-token

# ServiceNow — opcional (ativa testes do modo "Both" e "SN-only")
TEST_SN_INSTANCE=empresa.service-now.com
TEST_SN_USER=meu-usuario
TEST_SN_PASS=minha-senha
